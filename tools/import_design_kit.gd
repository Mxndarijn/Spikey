extends SceneTree
## Imports the design kit into the game.
##   godot --headless --path . -s res://tools/import_design_kit.gd
## Reads:
##   data/design/tokens.json        copy of the design kit's project/tokens.json
##   data/design/room_palettes.json extra times of day per world
##   data/design/extra_worlds.json  worlds beyond the kit (paid, seasonal)
## Writes:
##   game/style/ui_tokens.gd        UI tokens, spacing, radius, sizes, font sizes
##   data/themes/<id>.tres          one ThemeDef per world
## Afterwards run tools/check.ps1 (the sync test fails if this wasn't rerun).

const TOKENS := "res://data/design/tokens.json"
const PALETTES := "res://data/design/room_palettes.json"
const EXTRA := "res://data/design/extra_worlds.json"
const UI_OUT := "res://game/style/ui_tokens.gd"
const THEME_DIR := "res://data/themes"


func _initialize() -> void:
	var tokens: Dictionary = _read_json(TOKENS)
	var palettes: Dictionary = _read_json(PALETTES)
	var extra: Dictionary = _read_json(EXTRA)
	if tokens.is_empty():
		quit(1)
		return
	_write_ui_tokens(tokens)
	var written := _write_themes(tokens, palettes, extra.get("worlds", []))
	for file in DirAccess.get_files_at(THEME_DIR):
		if file.ends_with(".tres") and file.get_basename() not in written:
			print("note: %s is not in the design data any more; delete it if unused" % file)
	print("Imported %d worlds and UI tokens" % written.size())
	quit(0)


## Every world, in picker order: [{id, name, premium, price, tokens: {name: Color}}].
static func collect_worlds(tokens: Dictionary, extra_worlds: Array) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	var themes: Array = tokens.color.themes
	var first: String = themes[0].id
	for theme: Dictionary in themes:
		var values := {}
		for tok: Dictionary in tokens.color.tokens:
			if tok.value is Dictionary:
				values[tok.name] = Color(tok.value.get(theme.id, tok.value[first]))
		out.append(
			{"id": theme.id, "name": theme.name, "premium": false, "price": 0, "tokens": values}
		)
	for w: Dictionary in extra_worlds:
		var values := {}
		for k: String in w.tokens:
			values[k] = Color(w.tokens[k])
		(
			out
			. append(
				{
					"id": w.id,
					"name": w.name,
					"premium": w.get("premium", false),
					"price": int(w.get("price", 0)),
					"tokens": values,
				}
			)
		)
	return out


static func build_theme(world: Dictionary, order: int, palettes: Dictionary) -> ThemeDef:
	var t := ThemeDef.new()
	t.id = world.id
	t.display_name = world.name
	t.order = order
	t.premium = world.premium
	t.price = world.price
	for token_name in ThemeDef.WORLD_TOKENS:
		if world.tokens.has(token_name):
			t.set(token_name.replace("-", "_"), world.tokens[token_name])
	var list: Array[RoomPalette] = []
	for p: Dictionary in palettes.get(world.id, []):
		var rp := RoomPalette.new()
		# Stable ids keep regenerated files diff-free.
		rp.resource_scene_unique_id = "palette_%d" % list.size()
		rp.name = p.name
		rp.sky_top = Color(p.sky[0])
		rp.sky_mid = Color(p.sky[1])
		rp.sky_bottom = Color(p.sky[2])
		list.append(rp)
	t.room_palettes = list
	return t


func _write_themes(tokens: Dictionary, palettes: Dictionary, extra_worlds: Array) -> Array[String]:
	DirAccess.make_dir_recursive_absolute(THEME_DIR)
	var written: Array[String] = []
	var worlds := collect_worlds(tokens, extra_worlds)
	for i in worlds.size():
		var t := build_theme(worlds[i], i, palettes)
		var err := ResourceSaver.save(t, THEME_DIR.path_join(t.id + ".tres"))
		if err != OK:
			printerr("could not save theme ", t.id, ": ", error_string(err))
		written.append(t.id)
	return written


func _write_ui_tokens(tokens: Dictionary) -> void:
	var lines: Array[String] = [
		"class_name UiTokens",
		"extends RefCounted",
		"## GENERATED by tools/import_design_kit.gd from data/design/tokens.json.",
		"## Do not edit: change the design kit, copy its tokens.json, rerun the tool.",
		"## UI tokens are the same in every world; world tokens live in ThemeDef.",
		"",
		"# Colors",
	]
	for tok: Dictionary in tokens.color.tokens:
		if tok.value is String:
			var c := Color(tok.value)
			lines.append(
				(
					"const %s := Color(%.6f, %.6f, %.6f, %.6f)  # %s"
					% [_const_name(tok.name), c.r, c.g, c.b, c.a, tok.value]
				)
			)
	lines.append("")
	lines.append("# Spacing, px")
	lines.append_array(_int_consts(tokens.spacing.tokens, ""))
	lines.append("")
	lines.append("# Corner radius, px")
	lines.append_array(_int_consts(tokens.radius.tokens, ""))
	lines.append("")
	lines.append("# Sizes, logical px")
	lines.append_array(_int_consts(tokens.size.tokens, "SIZE_"))
	lines.append("")
	lines.append("# Font sizes, logical px")
	for group: Dictionary in tokens.type.groups:
		for style: Dictionary in group.styles:
			lines.append(
				"const FONT_SIZE_%s := %d" % [_const_name(style.name), _px(style.fontSize)]
			)
	lines.append("")
	lines.append("# Opacity")
	for tok: Dictionary in tokens.opacity.tokens:
		lines.append("const OPACITY_%s := %s" % [_const_name(tok.name), str(float(tok.value))])
	var f := FileAccess.open(UI_OUT, FileAccess.WRITE)
	f.store_string("\n".join(lines) + "\n")
	f.close()


static func _int_consts(list: Array, prefix: String) -> Array[String]:
	var out: Array[String] = []
	for tok: Dictionary in list:
		out.append("const %s%s := %d" % [prefix, _const_name(tok.name), _px(tok.value)])
	return out


static func _px(value: Variant) -> int:
	return int(str(value).trim_suffix("px"))


static func _const_name(token_name: String) -> String:
	return token_name.to_upper().replace("-", "_").replace(".", "_")


static func _read_json(path: String) -> Dictionary:
	var data: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
	if not data is Dictionary:
		printerr("could not read ", path)
		return {}
	return data
