class_name ThemeDef
extends Resource
## One world in the theme picker: the design kit's world tokens plus extra room
## palettes. Cosmetic only; never read by sim/. The files in data/themes/ are
## generated by tools/import_design_kit.gd from data/design/.

## The design kit's world tokens. Every world must provide all of them.
const WORLD_TOKENS: Array[String] = [
	"sky-top",
	"sky-mid",
	"sky-bottom",
	"glow",
	"spike",
	"spike-edge",
	"world-accent",
	"trail",
	"particle",
]
## Extra colours for the flat layered room scenes (data/design/world_scenes.json).
const SCENE_TOKENS: Array[String] = [
	"sun-ring",
	"cloud",
	"hill-far",
	"hill-mid",
	"hill-near",
	"prop",
	"ink",
	"paper",
]

@export var id := ""
@export var display_name := ""
## Position in the theme picker.
@export var order := 0
@export var sky_top := Color.WHITE
@export var sky_mid := Color.WHITE
@export var sky_bottom := Color.WHITE
@export var glow := Color.WHITE
@export var spike := Color.BLACK
@export var spike_edge := Color.BLACK
@export var world_accent := Color.WHITE
@export var trail := Color.WHITE
@export var particle := Color.WHITE
## Scene colours: the ring around the sun or moon, clouds, the far, middle and
## near hill layers, props (trees and the like), and the world's text (ink) and
## chip (paper) colours.
@export var sun_ring := Color.WHITE
@export var cloud := Color.WHITE
@export var hill_far := Color.WHITE
@export var hill_mid := Color.WHITE
@export var hill_near := Color.WHITE
@export var prop := Color.BLACK
@export var ink := Color.BLACK
@export var paper := Color.WHITE
## Where the sky blend from top to mid ends, as a fraction of the room height.
@export var sky_split := 0.62
## Night worlds have stars and a moon instead of a sun.
@export var night := false
## Extra times of day. Room 0 uses the base sky, then each palette in turn.
@export var room_palettes: Array[RoomPalette] = []
## Shop data for paid and seasonal worlds (Phase 2).
@export var premium := false
@export var price := 0
## Month a seasonal world belongs to ("October"), empty for all-year worlds.
@export var season := ""


func palette_count() -> int:
	return 1 + room_palettes.size()


## Sky stops (top, mid, bottom) for the room with this index.
func sky_for_room(room_index: int) -> Array[Color]:
	var i := room_index % palette_count()
	if i == 0:
		return [sky_top, sky_mid, sky_bottom]
	return room_palettes[i - 1].stops()


## Every sky stop the world can show, for contrast checks.
func all_sky_stops() -> Array[Color]:
	var out: Array[Color] = []
	for i in palette_count():
		out.append_array(sky_for_room(i))
	return out


## A world or scene token by its design-kit name, e.g. "spike-edge" or "hill-far".
func token(token_name: String) -> Color:
	return get(token_name.replace("-", "_"))
