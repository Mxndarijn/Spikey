# Godot
.godot/
# Godot's Android build template (installed at export). The Firebase plugin's
# libraries in android/firebase_* are tracked.
/android/build/
/android/.build_version
# Firebase config, written by CI from secrets (docs/PUSH_SETUP.md)
/google-services.json
/GoogleService-Info.plist
# Firebase iOS libraries, fetched by the iOS workflow
/ios/plugins/
*.translation
/build/

# Local tool config
tools/godot_path.txt
# Supabase project address + public key (docs/LEADERBOARD_SETUP.md)
services/supabase_config.json

# OS / editors
.DS_Store
Thumbs.db
.vscode/
*.tmp

# Signing files (never commit)
*.keystore
*.jks
*.p12
*.p8
*.mobileprovision
*.b64

# RL bot training state (tools/rlbot.ps1 -Mode train)
/tools/rlbot/train_state.json
/tools/rlbot/train_state.json.tmp
/tools/rlbot/*.log
/tools/rlbot/teach_state.json
/tools/rlbot/teach_state.json.tmp
/tools/rlbot/old1/
/tools/rlbot/trials/
