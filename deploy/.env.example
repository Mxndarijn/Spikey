# Settings and secrets for one environment (docs/DEPLOY.md). Copy to
#   deploy/overlays/prod/.env.prod       and/or
#   deploy/overlays/staging/.env.staging
# Those files are git-ignored. Kustomize's secretGenerator turns them into the
# Secret `flapjaw-env`; tools/deploy.ps1 reads the deploy settings from them.

# --- Deploy settings (read by tools/deploy.ps1) ---
# Where images are pushed and pulled from. GitHub Container Registry by default.
REGISTRY=ghcr.io/<GITHUB_USER>
# Only for a private registry: the pull secret tools/deploy.ps1 makes.
REGISTRY_USER=
REGISTRY_TOKEN=
# The game API's host name; its DNS record points at the VM (tofu output ipv4).
API_HOST=<API_HOST>
# Let's Encrypt writes here about certificates that are about to expire.
ACME_EMAIL=<YOUR_EMAIL>
# The kubeconfig of the game's cluster (infra output `kubeconfig`).
KUBECONFIG_FILE=./flapjaw.kubeconfig

# --- The server ---
# Postgres: the same password in both. Make one with: openssl rand -hex 24
POSTGRES_PASSWORD=<DB_PASSWORD>
DATABASE_URL=postgres://flapjaw:<DB_PASSWORD>@postgres:5432/flapjaw
# Apps older than this request protocol are asked to update (BackendClient.API_VERSION).
MIN_API_VERSION=1
# Board alerts: the Firebase service account JSON, base64 (empty: no alerts).
FIREBASE_SERVICE_ACCOUNT=
# Invite links open the app (backend/src/links.rs). Android: the signing keys'
# SHA-256, comma-separated. Empty: the upload key only (built in). Once Play App
# Signing is on, add Google's app-signing key (Play Console > App integrity):
# ANDROID_CERT_SHA256=C0:2B:FE:32:99:DB:7B:BB:72:5E:8F:F2:B9:4A:F0:AC:21:B1:67:82:C1:C0:BD:63:42:3A:4B:D7:02:FA:4E:91,<GOOGLE_APP_SIGNING_SHA256>
ANDROID_CERT_SHA256=
# iOS: <APPLE_TEAM_ID>.com.mxndarijn.spikey. Empty: W4N3NH845V.com.mxndarijn.spikey (built in).
APPLE_APP_ID=
# The App Store id once the app is listed (empty: the page links a store search).
APP_STORE_ID=

# --- Backups: Hetzner Object Storage, or any S3-compatible bucket ---
BACKUP_S3_ENDPOINT=https://nbg1.your-objectstorage.com
BACKUP_S3_REGION=eu-central
BACKUP_S3_BUCKET=<BACKUP_BUCKET>
BACKUP_S3_ACCESS_KEY=<S3_ACCESS_KEY>
BACKUP_S3_SECRET_KEY=<S3_SECRET_KEY>
# Days of nightly dumps to keep.
BACKUP_KEEP_DAYS=14
